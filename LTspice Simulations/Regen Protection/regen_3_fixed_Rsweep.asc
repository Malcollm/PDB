TEXT 0 -64 Left 2 ;SOURCE -> HOT-SWAP (blocks reverse current)
TEXT 552 -64 Left 2 ;PDB BULK / TVS / MIN LOAD
TEXT 1712 576 Left 2 ;RJ18 = J18 jumper\n;1m = in, 1G = pulled
TEXT 384 400 Left 2 ;ESL: CBUS 10n,\n;Cact 10n, Cloc 1n
TEXT 0 -128 Left 2 ;FIXED: as drawn + freewheel diode (D_FW), local ceramic (Cloc), 1 nF sense filter (Csense), gate pulldown (RGPD)
TEXT 1328 848 Left 2 ;Aux rails held ideal (assumes 3.3 V / 6 V stay up during regen)
TEXT 0 672 Left 2 !.tran 0 5m 0 100n\n.nodeset V(bus)=47.7 V(act)=47.7 V(drain)=47.7 V(sense)=1.15 V(cmp)=0 V(gate)=0\n.include regen_models.lib\n.param Vsrc=48 Rsrc=20m Lsrc=1u\n.param Cbus=2.82m Cact=400u Rharn=10m Lharn=500n\n.param Pmin=50\n.param Ireg=20 t0=1m trise=0.5m tfall=0.5m thold=2m\n.param Ldump=1u RJ18=1m\n* sweep: Rdump is defined here only\n.step param Rdump list 0.33 0.47 0.56 0.68 0.82 1\n.meas TRAN Vbus_pk   MAX V(bus) ; at PDB, includes switching spikes\n.meas TRAN Vact_pk   MAX V(act) ; at actuator, = what the chopper holds\n.meas TRAN Idump_pk  MAX I(Rdump)\n.meas TRAN Pdump_pk  MAX V(bus,dm)*I(Rdump)\n.meas TRAN Pdump_avg AVG V(bus,dm)*I(Rdump) FROM 1m TO 4m\n.meas TRAN E_dump    INTEG V(bus,dm)*I(Rdump)\n.meas TRAN E_tvs     INTEG -V(bus)*I(D_TVS)\n.meas TRAN Vds_pk    MAX V(drain)\n.meas TRAN E_fet     INTEG V(drain)*Id(M_Q6)\n* tests: 1 = pass, 0 = fail\n.meas TRAN PASS_bus PARAM Vact_pk<54\n.meas TRAN PASS_tvs PARAM E_tvs<0.01\n.meas TRAN PASS_vds PARAM Vds_pk<80
TEXT 1328 944 Left 2 ;Results: View > SPICE Output Log \n;RJ18=1G simulates J18 pulled (chopper off)
